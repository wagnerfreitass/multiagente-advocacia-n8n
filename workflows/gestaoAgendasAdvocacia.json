      "name": "Espera 1 segundo1"
    },
    {
      "parameters": {
        "jsCode": "// Definir horário de início e fim\nconst startHour = 8; // 08:00\nconst endHour = 18;  // 18:00\n// Definir horário do intervalo de almoço\nconst lunchStartHour = 12; // 12:00\nconst lunchEndHour = 14;   // 14:00\nconst timeSlots = [];\nconst iCalUID = $('Start').first().json.iCalUID;\nconst dateSlot = $('Start').first().json.dateSlots; // Recebendo a data do slot\n// Obter a data e hora atuais\nconst now = new Date();\nconst currentDate = now.toISOString().split('T')[0]; // Formato YYYY-MM-DD\nconst currentHour = now.getHours();\nconst currentMinute = now.getMinutes();\n// Verificar se a data do slot é a data atual\nconst isToday = dateSlot === currentDate;\n// Gerar intervalos de 1 hora, excluindo o intervalo de almoço\nfor (let hour = startHour; hour < endHour; hour++) {\n  // Pular os horários de almoço\n  if (hour >= lunchStartHour && hour < lunchEndHour) {\n    continue; // Pula este horário e vai para o próximo\n  }\n  \n  // Se não for hoje, incluir todos os horários (exceto almoço)\n  // Se for hoje, incluir apenas horários futuros (exceto almoço)\n  if (!isToday || hour > currentHour || (hour === currentHour && currentMinute === 0)) {\n    const startTime = `${hour.toString().padStart(2, '0')}:00`;\n    const endTime = `${(hour + 1).toString().padStart(2, '0')}:00`;\n    \n    timeSlots.push({\n      start: startTime,\n      end: endTime,\n      date: dateSlot,\n      iCalUID: iCalUID\n    });\n  }\n}\n// Retornar os dados no formato esperado pelo n8n\nreturn timeSlots.map(slot => ({ json: slot }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -992,
        3104
      ],
